#----------- options
option presolve_eps 1e-5;
option solver ipopt;

#----------- block problem
problem BLOCKTEST :
  UTOT,
  t,
  q,
  v,
  a,
  u
;

#----------- solve
solve BLOCKTEST > nul;
if solve_result != 'solved' then {
  print 'failed!', 'BLOCKTEST', '--', BLOCKTEST.result, '--',  BLOCKTEST.message;
}

option send_email yes;
