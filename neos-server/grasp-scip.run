#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#* settings
#----------- options
option presolve_eps 1e-14;

option presolve 1;
#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#* settings!

#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#* grasp test
#----------- grasp problem
problem GRASPTEST :
  NUM_FINGERS,
  q, v, a, f, c, fingers,
  {i1 in Q, i2 in GRID[0]: i1 <= nm} EOM[1, i1, i2],
  FC_NO_CONTACT, FC_NO_WRENCH, FPC,
  Q_OBJECT, V_OBJECT, A_OBJECT,
  NUM_CONTACTS, FORM_CLOSURE, MATRIX_RANK
;

#----------- solve
solve GRASPTEST;
if solve_result != 'solved' then {
  print 'failed!', 'GRASPTEST', '--', GRASPTEST.result, '--',  GRASPTEST.message;
}
#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#*#* grasp test!

